# Google AI Studio Gemini API Key
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended fast multimodal models: gemini-flash-lite-latest, gemini-flash-latest, gemini-3.8-flash
GEMINI_MODEL=gemini-flash-lite-latest

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=sightassist-app
FIREBASE_STORAGE_BUCKET=sightassist-app.appspot.com

# App Mode (development / production)
APP_ENVIRONMENT=development
ENABLE_DEBUG_SPEECH=true
